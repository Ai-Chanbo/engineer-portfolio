# ------------------------------------------------------------------
# Contact form (Resend)
# ------------------------------------------------------------------
# Without RESEND_API_KEY the /api/contact route runs in MOCK mode:
# submissions are validated and logged to the server console, and the
# success screen is shown — no email is sent. Set the key to go live.

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=

# Where contact submissions are delivered (defaults to site.email).
CONTACT_TO_EMAIL=

# Verified sender address on your Resend domain.
# Use onboarding@resend.dev for quick testing.
CONTACT_FROM_EMAIL=onboarding@resend.dev
